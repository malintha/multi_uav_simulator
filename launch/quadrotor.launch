  </node>

  <!-- =====================  robot_6  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_6" namespace="mavswarm2" output="screen"
        args="6 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        namespace="mavswarm2/robot_6" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share mavswarm2)/cf_description/crazyflie.urdf.xacro robot_id:=6')"/>
    <param name="frame_prefix" value="robot_6/"/>
  </node>

  <!-- =====================  robot_7  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_7" namespace="mavswarm2" output="screen"
        args="7 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        namespace="mavswarm2/robot_7" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share mavswarm2)/cf_description/crazyflie.urdf.xacro robot_id:=7')"/>
    <param name="frame_prefix" value="robot_7/"/>
  </node>

  <!-- =====================  robot_8  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_8" namespace="mavswarm2" output="screen"
        args="8 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        namespace="mavswarm2/robot_8" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share mavswarm2)/cf_description/crazyflie.urdf.xacro robot_id:=8')"/>
    <param name="frame_prefix" value="robot_8/"/>
  </node>

  <!-- =====================  robot_9  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_9" namespace="mavswarm2" output="screen"
        args="9 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        namespace="mavswarm2/robot_9" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share mavswarm2)/cf_description/crazyflie.urdf.xacro robot_id:=9')"/>
    <param name="frame_prefix" value="robot_9/"/>
  </node>

  <!-- =====================  visualisation  ===================== -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" namespace="" output="screen"
        args="-d $(find-pkg-share mavswarm2)/config/simulation.rviz"/>

</launch>
