<launch>

  <arg name="controller_frequency" default="100"/>
  <arg name="log_level" default="INFO"/>

  <!-- =====================  robot_0  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_0" namespace="mavswarm2" output="screen"
        args="0 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        namespace="mavswarm2/robot_0" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share mavswarm2)/cf_description/crazyflie.urdf.xacro robot_id:=0')"/>
    <param name="frame_prefix" value="robot_0/"/>
  </node>

  <!-- =====================  robot_1  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_1" namespace="mavswarm2" output="screen"
        args="1 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        namespace="mavswarm2/robot_1" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share mavswarm2)/cf_description/crazyflie.urdf.xacro robot_id:=1')"/>
    <param name="frame_prefix" value="robot_1/"/>
  </node>

  <!-- =====================  robot_2  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_2" namespace="mavswarm2" output="screen"
        args="2 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        namespace="mavswarm2/robot_2" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share mavswarm2)/cf_description/crazyflie.urdf.xacro robot_id:=2')"/>
    <param name="frame_prefix" value="robot_2/"/>
  </node>

  <!-- =====================  robot_3  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_3" namespace="mavswarm2" output="screen"
        args="3 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        namespace="mavswarm2/robot_3" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share mavswarm2)/cf_description/crazyflie.urdf.xacro robot_id:=3')"/>
    <param name="frame_prefix" value="robot_3/"/>
  </node>

  <!-- =====================  robot_4  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_4" namespace="mavswarm2" output="screen"
        args="4 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
  </node>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        namespace="mavswarm2/robot_4" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share mavswarm2)/cf_description/crazyflie.urdf.xacro robot_id:=4')"/>
    <param name="frame_prefix" value="robot_4/"/>
  </node>

  <!-- =====================  robot_5  ===================== -->
  <node pkg="mavswarm2" exec="mavswarm2" name="robot_5" namespace="mavswarm2" output="screen"
        args="5 $(var controller_frequency) --ros-args --log-level $(var log_level)">
    <param from="$(find-pkg-share mavswarm2)/config/crazyflie_params.yaml"/>
    <param from="$(find-pkg-share mavswarm2)/config/initial_conditions_2.yaml"/>
